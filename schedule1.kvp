Meta.DisplayName=Schedule I (S1 DedicatedServerMod)
Meta.Description=Headless authoritative Schedule I server using ifBars/S1DedicatedServers (IL2CPP, MelonLoader). Requires a Steam account that owns Schedule I.
Meta.NoCommercialUsage=False
Meta.OS=Windows
Meta.Arch=x86_64
Meta.URL=https://github.com/ifBars/S1DedicatedServers
Meta.ReleaseNotesURL=https://github.com/ifBars/S1DedicatedServers/releases
Meta.DisplayImageSource=steam:3164500
Meta.ConfigManifest=schedule1config.json
Meta.ConfigRoot=schedule1.kvp
App.DisplayName=Schedule I Dedicated Server
App.RootDir=./s1ds/
App.BaseDirectory=./s1ds/
App.WorkingDir=./s1ds/
App.ExecutableWin=./s1ds/Schedule I.exe
App.CommandLineArgs=--dedicated-server --stdio-console --server-name "{{ServerName}}" --max-players {{MaxPlayers}} --auth-provider {{AuthProvider}} --block-known-risky-client-mods {{BlockRiskyClientMods}} {{FormattedArgs}}
App.ExitMethod=OS_CLOSE
App.ExitTimeoutSeconds=30
App.HasWriteableConsole=True
App.UseLinuxIOREDIR=False
App.SupportsLiveSettingsChanges=False
App.Ports=[{"Protocol":"UDP","Port":38465,"Name":"Game Port","Description":"Gameplay traffic (serverPort in server_config.toml). Players connect here.","Ref":"GamePort"},{"Protocol":"UDP","Port":27016,"Name":"Steam Query Port","Description":"Steam game server query port.","Ref":"QueryPort"}]
