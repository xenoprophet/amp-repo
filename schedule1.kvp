Meta.DisplayName=Schedule I (S1 DedicatedServerMod)
Meta.Description=Headless authoritative Schedule I server using ifBars/S1DedicatedServers (IL2CPP, MelonLoader). Requires a Steam account that owns Schedule I.
Meta.OS=Windows
Meta.Arch=x86_64
Meta.Author=Personal template
Meta.URL=https://github.com/ifBars/S1DedicatedServers
Meta.DisplayImageSource=steam:3164500
Meta.ConfigManifest=schedule1config.json
Meta.ConfigRoot=schedule1.kvp
Meta.DockerRequired=False
Meta.ContainerPolicy=NotSupported
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.AppConfigId=0f9fa142-1058-40e0-af68-259fb0ac42c9
App.DisplayName=Schedule I
App.RootDir=./s1ds/
App.BaseDirectory=./s1ds/3164500/
App.ExecutableWin=3164500\Schedule I.exe
App.WorkingDir=3164500
App.CommandLineArgs=--dedicated-server --stdio-console --server-name "{{ServerName}}" --max-players {{MaxPlayers}} --auth-provider {{AuthProvider}} --block-known-risky-client-mods {{BlockRiskyClientMods}} {{CustomArgs}}
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId":"3164500","SteamGameId":"3164500"}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[schedule1ports.json]
App.PrimaryApplicationPortRef=GamePort
App.MaxUsers=8
App.UpdateSources=@IncludeJson[schedule1updates.json]
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
